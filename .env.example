# Disparos de dossie do quiz via API Oficial.
# Ative somente quando os 4 templates dossie_* estiverem aprovados no Meta.
DOSSIE_WHATSAPP_ENABLED=false

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Follow-up 6h tambem deve ficar desligado enquanto o canal oficial nao estiver pronto.
FOLLOWUP_6H_ENABLED=false

# Cadencia oficial para quem terminou o quiz e nao comprou/respondeu.
# Ative somente depois que os templates abaixo estiverem aprovados no Meta.
QUIZ_CADENCE_ENABLED=false
QUIZ_CADENCE_1H_TEMPLATE=quiz_retomada_1h
QUIZ_CADENCE_24H_TEMPLATE=quiz_prova_24h
QUIZ_CADENCE_72H_TEMPLATE=quiz_ultima_chamada_72h
# Branch comercial: acompanhamento direto com Evelyn (conservador por padrão).
EVELYN_BRANCH_ENABLED=false
EVELYN_BRANCH_PILOT_PERCENT=100
EVELYN_BRANCH_ALLOWED_SOURCES=
EVELYN_PRICE_BRL=4800
EVELYN_JOURNEY_BASE_URL=https://jornada.tableclinic.com.br
# Opcional: sobrescreve o checkout InfinitePay configurado no código.
EVELYN_CHECKOUT_URL=https://checkout.infinitepay.io/tableclinic/Fllvy2wB2O
# Mesmo endpoint/segredo do dataset durável no Hub.
HUB_EVELYN_EVENT_URL=https://crm.tableclinic.com.br/webhook/evelyn-branch/event
